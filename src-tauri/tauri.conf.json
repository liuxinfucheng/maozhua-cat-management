{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "猫爪猫咪管理后台",
  "version": "0.1.0",
  "identifier": "com.maozhua.catmanagement",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "猫爪猫咪管理后台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "本地离线的猫咪信息管理工具"
  }
}
